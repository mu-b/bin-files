#!/usr/bin/env bash
#
# post-checkout - refresh ~/bin symlinks after a branch checkout.
#
# args: $1 = previous HEAD, $2 = new HEAD, $3 = flag (1 = branch checkout).

set -euo pipefail

# only act on branch checkouts, not file checkouts
[[ "${3:-0}" == "1" ]] || exit 0

root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "$root" && -x "$root/install.sh" ]] || exit 0

"$root/install.sh" >/dev/null || echo "post-checkout: install.sh failed" >&2
